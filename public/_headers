# Cloudflare Pages applies these headers to all responses.
# See: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Static assets — moderate cache. No content hashing in filenames yet,
# so we don't want a year-long cache that would strand visitors on old CSS.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# On-site survey app: photo stamps need the phone's location (the site-wide rule above switches it off)
/admin/survey/*
  ! Permissions-Policy
  Permissions-Policy: geolocation=(self), microphone=(), camera=(self), interest-cohort=()

# Invoicing system: private pages, never indexed or framed.
/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/pay/*
  X-Robots-Tag: noindex, nofollow
/invoice/*
  X-Robots-Tag: noindex, nofollow
/fee-invoice/*
  X-Robots-Tag: noindex, nofollow
/partner*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Admin app script: always revalidate so deploys show up straight away.
/assets/admin.js
  Cache-Control: no-cache
